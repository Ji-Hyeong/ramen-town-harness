extends "res://tests/chef_challenge_qa.gd"
## Real pointer/controller/disk acceptance, using an earned raw checkpoint.
## Accelerated session clocks are not human playtime or physical-phone testing.
const ServerFixture=preload("res://tests/server_integration_tests.gd")
var _server_profiles: int=0

func _run() -> void:
	for profile in [{"tag":"portrait","size":Vector2i(390,844)},{"tag":"desktop","size":Vector2i(1280,800)},{"tag":"compact","size":Vector2i(390,750)}]:
		await _server_flow(profile["tag"],profile["size"])
	_check(_server_profiles==3,"all server profiles reach the final assertion")
	print("SERVER CHALLENGE mode=%s checks=%d failures=%d" % ["layout-only" if _layout_only else "capture",_checks,_failures.size()])
	for failure in _failures:printerr("FAIL: "+failure)
	quit(0 if _failures.is_empty() else 1)

func _server_flow(tag: String,vp: Vector2i) -> void:
	var holder:=SubViewport.new();holder.size=vp;holder.handle_input_locally=true;holder.render_target_update_mode=SubViewport.UPDATE_ALWAYS;root.add_child(holder)
	var folder: String=_data_root.path_join(tag)
	_check(DirAccess.make_dir_recursive_absolute(folder)==OK,"isolated server QA save")
	var app: Control=await _spawn(holder,folder);app.set_process(false)
	app.set("state",ServerFixture.State.new());await _update(app)
	app.call("_open_overlay",5);await _settle()
	var view: Control=app.get("_growth_view")
	await _tap(holder,view,"GrowthServer")
	_bounds(holder,view,tag+" locked")
	_check((view.find_child("GrowthPrimary",true,false) as Button).disabled,"fresh raw game cannot accept rank2 challenge")
	await _shot(holder,tag+"_server_01_locked.png")
	var fixture:=ServerFixture.new();fixture.check=_check
	var st: Object=fixture.fresh();fixture.setup(st)
	app.set("state",st);await _update(app)
	await _tap(holder,view,"GrowthBack")
	var before: String=_json(st)
	var card: Button=view.find_child("GrowthServer",true,false)
	var scroll: ScrollContainer=view.find_child("GrowthScroll",true,false)
	scroll.ensure_control_visible(card);await _settle()
	var point: Vector2=card.get_global_rect().get_center()
	_point(holder,point,true);await _frames(3)
	for label in card.find_children("*","Label",true,false):
		_check(label.get_theme_color("font_color")==Color.WHITE,"pressed custom card labels remain legible")
	await _shot(holder,tag+"_server_00_pressed.png")
	for step in 6:
		var event:=InputEventMouseMotion.new();point.y-=12
		event.position=point;event.global_position=point;event.relative=Vector2(0,-12);event.button_mask=MOUSE_BUTTON_MASK_LEFT
		holder.push_input(event);await _frames(1)
	_point(holder,point,false);await _settle()
	for label in card.find_children("*","Label",true,false):
		_check(label.get_theme_color("font_color")!=Color.WHITE,"drag cancellation restores custom card foreground")
	_check(view.get("_page")=="list" and _json(st)==before,"whole server card drag cancels navigation and cannot change progress")
	await _tap(holder,view,"GrowthServer")
	_bounds(holder,view,tag+" open")
	await _shot(holder,tag+"_server_02_open.png")
	var wallet: int=st.wallet
	await _tap(holder,view,"GrowthPrimary")
	_check(st.server_challenge_review()["status"]=="active" and st.wallet==wallet,"actual pointer accepts free challenge")
	await _tap(holder,view,"ServerConditions")
	before=_json(st)
	_bounds(holder,view,tag+" details")
	await _shot(holder,tag+"_server_03_conditions.png")
	scroll=view.find_child("GrowthScroll",true,false)
	scroll.scroll_vertical=999999;await _settle()
	_bounds(holder,view,tag+" condition bottom")
	await _shot(holder,tag+"_server_04_conditions_bottom.png")
	_check(_json(st)==before,"reading conditions is pure")
	await _tap(holder,view,"GrowthPrimary")
	_check((app.get("_operations_view") as Control).visible,"active challenge routes to real selling screen")
	await _actual_service(app)
	_check(st.server_challenge_review()["status"]=="active" and not st.server_challenge_review()["rows"][0]["met"],"actual old menus do not qualify")
	await _tap(holder,app.get("_service_result"),"ResultServer")
	_check(view.get("_page")=="server" and view.visible,"receipt routes to actual server depth")
	_bounds(holder,view,tag+" failed")
	await _shot(holder,tag+"_server_05_failed.png")
	# Restart the same earned fixture for the tested attainable service day.
	st=fixture.fresh();fixture.setup(st);_check(st.start_server_challenge()["ok"],"fresh isolated accepted challenge")
	var ids: Array=fixture.revise(st)
	_check(st.set_selling_menus(ids)["ok"],"actual two revised menus explicitly pinned")
	app.set("state",st);await _update(app)
	await _actual_service(app)
	_check(st.server_challenge_review()["status"]=="ready","real two-menu raw service meets all conditions")
	await _shot(holder,tag+"_server_06_ready_receipt.png")
	await _tap(holder,app.get("_service_result"),"ResultServer")
	view.call("set","_server_details",false);view.call("_render");await _settle()
	_bounds(holder,view,tag+" ready")
	await _shot(holder,tag+"_server_07_ready.png")
	_check(app.call("_persist"),"ready proof saved")
	var saver: Object=app.get("saver")
	var disk: String=FileAccess.get_file_as_string(saver.main_path())
	_check(DirAccess.make_dir_recursive_absolute(saver.tmp_path())==OK,"own isolated save failure")
	wallet=st.wallet
	await _tap(holder,view,"GrowthPrimary")
	_check(st.server_challenge_review()["status"]=="mastered" and st.wallet==wallet and FileAccess.get_file_as_string(saver.main_path())==disk,"one-time mastery in memory; previous disk preserved on failed save")
	_check(float(app.get("_training_left"))>0 and (view.find_child("GrowthPrimary",true,false) as Button).disabled,"actual celebration blocks repeat")
	app.call("advance_training",1.0);app.call("_sync_bowl_editor");await _settle()
	_bounds(holder,view,tag+" celebration")
	await _shot(holder,tag+"_server_08_celebration_save_failure.png")
	before=_json(st)
	app.call("advance_training",2.0);app.call("_sync_bowl_editor");await _settle()
	app.call("_on_growth_view_action","server_claim","","")
	_check(_json(st)==before,"claim replay never repeats mastery")
	await _tap(holder,view,"GrowthNotice")
	await _shot(holder,tag+"_server_09_save_failure.png")
	_check(DirAccess.remove_absolute(saver.tmp_path())==OK,"remove only own empty conflict")
	app.call("_on_manual_save_pressed");app.call("_sync_bowl_editor");await _settle()
	_check(not (app.get("_banner") as Control).visible,"manual save recovery")
	var saved: String=_json(st);app.queue_free();await _frames(3)
	app=await _spawn(holder,folder);app.set_process(false)
	_check(_json(app.get("state"))==saved,"entire state exact after real disk restart")
	app.call("_open_overlay",5);await _settle();view=app.get("_growth_view")
	await _tap(holder,view,"GrowthServer")
	_bounds(holder,view,tag+" restart")
	await _shot(holder,tag+"_server_10_mastered_restart.png")
	await _actual_service(app)
	_check(app.get("state").last_report["staffing"].get("server",0)==1,"actual next-service receipt includes earned mastery")
	await _shot(holder,tag+"_server_11_mastered_receipt.png")
	_server_profiles+=1
	app.queue_free();await _frames(3);holder.queue_free();await _settle()
