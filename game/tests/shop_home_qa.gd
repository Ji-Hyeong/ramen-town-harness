extends "res://tests/bowl_editor_qa.gd"
## Native pointer acceptance against isolated public-state transactions. The
## compact mode exercises identical controls without claiming rendered proof.
const HomeFixture = preload("res://tests/harbor_foraging_tests.gd")
const HomeCheck = preload("res://scripts/domain/data_check.gd")


func _run() -> void:
	var profiles: Array=[{"tag":"portrait","size":Vector2i(390,844)},{"tag":"desktop","size":Vector2i(1280,800)}]
	if OS.get_cmdline_user_args().has("--home-compact"):
		profiles=[{"tag":"compact","size":Vector2i(390,750)}]
	for profile in profiles:
		await _home_flow(profile["tag"],profile["size"])
		await _protected_save(profile["tag"],profile["size"])
	print("SHOP HOME mode=%s checks=%d failures=%d" % ["layout-only" if _layout_only else "capture",_checks,_failures.size()])
	for failure in _failures: printerr("FAIL: "+failure)
	quit(0 if _failures.is_empty() else 1)


func _home_json(st: Object) -> String:
	return JSON.stringify(st.to_dict(),"",true)


func _geometry(holder: SubViewport, app: Node, tag: String) -> void:
	var viewport:=Rect2(Vector2.ZERO,Vector2(holder.size))
	var shop: Dictionary=app.get("_shop").scene_info()
	_check(int(shop["scale"])>= (4 if holder.size.x>=1000 else 2),tag+": original scene integer scale")
	_check(viewport.encloses(shop["rect"]),tag+": entire original shop within viewport")
	for name in ["Hud","StatusStrip","NavBar"]:
		var control: Control=app.find_child(name,true,false)
		_check(viewport.encloses(control.get_global_rect()),tag+": "+name+" within viewport")
		_check(not control.get_global_rect().intersects(shop["rect"]),tag+": "+name+" never covers shop")
	for name in ["DevButton","StartServiceButton","HomeInfo","HomeStatusDetails"]:
		var target: Control=app.find_child(name,true,false)
		_check(target.size.y>=44 and viewport.encloses(target.get_global_rect()),tag+": usable target "+name)
	for name in ["DayLabel","WalletLabel"]:
		var text: Label=app.find_child(name,true,false)
		var pixels: int=text.get_theme_font_size("font_size")
		var needed: Vector2=text.get_theme_font("font").get_string_size(text.text,HORIZONTAL_ALIGNMENT_LEFT,-1,pixels)
		_check(text.size.x>=needed.x-1 and text.size.y>=needed.y-1,tag+": uncut "+name)
	var status: Control=app.get("_status")
	for name in ["ClockLabel","HomeMenuName","HomeMenuNote"]:
		var text: Label=app.find_child(name,true,false)
		_check(status.get_global_rect().grow(-5).encloses(text.get_global_rect()),tag+": summary content inside real frame padding "+name)
		var minimum: float=text.get_theme_font("font").get_string_size(text.text,HORIZONTAL_ALIGNMENT_LEFT,-1,text.get_theme_font_size("font_size")).x if name=="ClockLabel" else 100.0
		_check(text.get_line_count()==1 and text.size.x>=minimum-1 and _text_height_fits(text),tag+": summary text has usable one-line geometry "+name)
	var dish: Control=app.find_child("HomeDish_0",true,false)
	if dish!=null:
		_check(status.get_global_rect().grow(-5).encloses(dish.get_global_rect()) and dish.size.y>=38,tag+": actual selling dish fits summary frame")


func _detail_bounds(holder: SubViewport, home: Control, tag: String) -> void:
	var frame: Control=home.find_child("HomeDetailsPanel",true,false)
	var close: Control=home.find_child("HomeDetailsClose",true,false)
	var save: Control=home.find_child("HomeSave",true,false)
	var scroll: Control=home.find_child("HomeDetailsScroll",true,false)
	_check(Rect2(Vector2.ZERO,Vector2(holder.size)).encloses(frame.get_global_rect()),tag+": details fit viewport")
	_check(frame.get_global_rect().encloses(close.get_global_rect()) and close.size.y>=44,tag+": fixed close reachable")
	_check(frame.get_global_rect().encloses(save.get_global_rect()) and scroll.get_global_rect().end.y<=save.get_global_rect().position.y,tag+": fixed save outside scrolling content")


func _home_flow(tag: String, vp: Vector2i) -> void:
	var holder:=SubViewport.new()
	holder.size=vp
	holder.handle_input_locally=true
	holder.render_target_update_mode=SubViewport.UPDATE_ALWAYS
	root.add_child(holder)
	var dir: String=_data_root.path_join(tag+"_home")
	_check(DirAccess.make_dir_recursive_absolute(dir)==OK,"isolated home directory")
	var app: Control=await _spawn(holder,dir)
	app.set_process(false)
	var st: Object=app.get("state")
	var home: Control=app.get("_home")
	var details: Control=home.get("_details")
	_geometry(holder,app,tag+" empty")
	await _shot(holder,tag+"_home_01_empty.png")
	var before: String=_home_json(st)
	var feedback: Object=app.get("_juice")
	var acks: int=feedback.acknowledgement_count()
	var menu_target: Control=home.find_child("HomeInfo",true,false)
	_point(holder,menu_target.get_global_rect().get_center(),true)
	await _shot(holder,tag+"_home_00_pressed.png")
	_point(holder,menu_target.get_global_rect().get_center(),false)
	await _settle()
	_check(details.visible and feedback.acknowledgement_count()>acks,tag+": real menu touch and global feedback")
	_check((home.find_child("HomeLastReport",true,false) as Button).disabled,tag+": no invented previous receipt")
	_detail_bounds(holder,home,tag+" empty")
	await _tap(holder,home,"HomeDetailsClose")
	_check(not details.visible and _home_json(st)==before,tag+": details do not transact")
	await _tap(holder,app,"StartServiceButton")
	app.call("_sync_bowl_editor")
	_check((app.get("_bowl_editor") as Control).visible,tag+": first-menu CTA reaches actual editor")
	app.call("_close_overlay")
	app.call("_sync_bowl_editor")
	_check(st.set_draft_name("가게의 첫 라멘")["ok"] and st.taste()["ok"],tag+": real first tasting")
	var sold: Dictionary=st.selling_records()[0]["config"].duplicate(true)
	_check(st.set_draft_choice("broth","broth_chicken")["ok"],tag+": actual separate draft edit")
	app.call("_refresh_all")
	await _settle()
	_check(HomeCheck.same_config(home.find_child("HomeDish_0",true,false).get("config"),sold),tag+": thumbnail is selling recipe, never draft")
	_geometry(holder,app,tag+" selling")
	await _shot(holder,tag+"_home_02_selling.png")
	before=_home_json(st)
	acks=feedback.acknowledgement_count()
	await _drag_list(holder,(home.find_child("HomeStatusDetails",true,false) as Control).get_global_rect().get_center())
	_check(not details.visible and feedback.acknowledgement_count()==acks,tag+": leaving card while swiping cancels navigation and success effect")
	await _tap(holder,home,"HomeStatusDetails")
	_check(details.visible and HomeCheck.same_config(home.find_child("HomeDetailDish_0",true,false).get("config"),sold),tag+": reachable exact menu detail")
	_detail_bounds(holder,home,tag+" selling")
	await _shot(holder,tag+"_home_03_details.png")
	await _tap(holder,home,"HomeGrowth")
	_check(not details.visible and app.get("tabs").current_tab==5 and app.get("_overlay").visible,tag+": actual guarded growth route")
	app.call("_close_overlay")
	await _tap(holder,home,"HomeInfo")
	await _tap(holder,home,"HomeExplore")
	_check((app.get("_exploration_view") as Control).visible,tag+": actual native exploration route")
	app.call("_close_overlay")
	app.call("_sync_bowl_editor")
	await _tap(holder,home,"HomeInfo")
	await _tap(holder,home,"HomeMenus")
	_check(app.get("tabs").current_tab==3 and app.get("_overlay").visible,tag+": selling-management route")
	app.call("_close_overlay")
	_check(_home_json(st)==before,tag+": browsing retains edited draft and ledger")
	var wallet: int=st.wallet
	var day: int=st.day
	await _tap(holder,app,"StartServiceButton")
	_advance(app,300)
	app.call("_refresh_status")
	await _settle()
	_check(st.service_active() and st.wallet==wallet and st.day==day,tag+": live service never settles early")
	_check((app.get("_progress") as ProgressBar).value>0,tag+": actual session progress")
	_geometry(holder,app,tag+" active")
	await _shot(holder,tag+"_home_04_active.png")
	await _tap(holder,app,"SpeedButton")
	_check(app.get("_fast"),tag+": actual speed toggle")
	await _tap(holder,home,"HomeInfo")
	_check((home.find_child("HomeMenus",true,false) as Button).disabled,tag+": live roster protected")
	await _tap(holder,home,"HomeSave")
	_check((home.find_child("HomeManualSaveResult",true,false) as Label).text.contains("영업 중"),tag+": save has truthful active-service refusal")
	_check((home.find_child("HomeDetailsPanel",true,false) as Control).get_global_rect().encloses((home.find_child("HomeManualSaveResult",true,false) as Control).get_global_rect()),tag+": save refusal visible beside fixed action without scrolling")
	await _shot(holder,tag+"_home_05_live_details.png")
	await _tap(holder,home,"HomeDetailsClose")
	await _tap(holder,app,"StartServiceButton")
	_check(st.service_active() and (app.get("_start_button") as Button).text.contains("다시"),tag+": stop still requires confirmation")
	await _tap(holder,app,"StartServiceButton")
	_check(not st.service_active() and st.wallet==wallet and st.day==day,tag+": confirmed abort never settles")
	app.set("_flash_text","")
	app.call("_refresh_all")
	await _tap(holder,app,"StartServiceButton")
	await _tap(holder,home,"HomeInfo")
	_advance(app,6000)
	app.call("_process",0.0)
	await _settle()
	_check(st.day==day+1 and st.wallet==wallet+int(st.last_report["net"]),tag+": exact once-only settlement retained")
	_check(not details.visible,tag+": automatic result replaces live details and returns to actual shop")
	await _tap(holder,app.get("_service_result"),"ResultOkButton")
	await _tap(holder,home,"HomeInfo")
	await _tap(holder,home,"HomeLastReport")
	_check((app.get("_service_result") as Control).visible,tag+": real previous receipt opens from home")
	await _tap(holder,app.get("_service_result"),"ResultOkButton")
	var fixture:=HomeFixture.new()
	fixture.check=_check
	var prepared: Object=fixture.ready()
	_check(prepared.expand_shop()["ok"],tag+": real expansion")
	var ids: Array=[]
	for record in prepared.records(): ids.append(int(record["record_id"]))
	_check(prepared.set_selling_menus(ids)["ok"] and st.load_from_dict(prepared.to_dict())=="",tag+": public two-menu ledger")
	app.call("_refresh_all")
	await _settle()
	_geometry(holder,app,tag+" expanded")
	_check(home.find_child("HomeDish_1",true,false)!=null,tag+": actual second menu thumbnail")
	await _shot(holder,tag+"_home_06_expanded.png")
	await _tap(holder,home,"HomeInfo")
	await _shot(holder,tag+"_home_07_pair_details.png")
	holder.size=Vector2i(390,750)
	await _settle()
	_detail_bounds(holder,home,tag+" live compact resize")
	await _tap(holder,home,"HomeDetailsClose")
	_geometry(holder,app,tag+" live compact resize")
	holder.size=vp
	await _settle()
	var saver: Object=app.get("saver")
	_check(app.call("_persist"),tag+": successful save before conflict")
	var disk: String=FileAccess.get_file_as_string(saver.main_path())
	_check(DirAccess.make_dir_recursive_absolute(saver.tmp_path())==OK and not app.call("_persist"),tag+": real scoped save failure")
	_check(FileAccess.get_file_as_string(saver.main_path())==disk,tag+": failure preserves saved bytes")
	await _settle()
	_geometry(holder,app,tag+" warning")
	_check((home.find_child("HomeInfo",true,false) as Button).text.contains("저장"),tag+": failure visible on home")
	await _shot(holder,tag+"_home_08_save_warning.png")
	await _tap(holder,home,"HomeInfo")
	_check((app.get("_banner_label") as Label).is_visible_in_tree() and (app.get("_banner_label") as Label).text.contains("닫으면 사라질 수"),tag+": original full warning actually reachable")
	await _shot(holder,tag+"_home_09_save_details.png")
	await _tap(holder,home,"HomeSave")
	_check((home.find_child("HomeManualSaveResult",true,false) as Label).text.contains("저장하지 못"),tag+": retry never falsely reports success")
	_check(DirAccess.remove_absolute(saver.tmp_path())==OK,tag+": remove only own conflict")
	await _tap(holder,home,"HomeSave")
	_check(not (app.get("_banner") as Control).visible and (home.find_child("HomeManualSaveResult",true,false) as Label).text.contains("저장했"),tag+": actual recovery")
	await _tap(holder,home,"HomeDetailsClose")
	_check((home.find_child("HomeInfo",true,false) as Button).text=="",tag+": warning affordance clears after actual success")
	_check(st.start_expedition("market")["ok"],tag+": real travel start")
	app.call("_refresh_all")
	await _tap(holder,app,"StartServiceButton")
	_check((app.get("_exploration_view") as Control).visible and st.exploration_active(),tag+": real trip continuation")
	app.call("_close_overlay")
	app.call("_sync_bowl_editor")
	app.queue_free()
	await _frames(3)
	holder.queue_free()
	await _settle()


func _protected_save(tag: String, vp: Vector2i) -> void:
	var holder:=SubViewport.new()
	holder.size=vp
	holder.handle_input_locally=true
	holder.render_target_update_mode=SubViewport.UPDATE_ALWAYS
	root.add_child(holder)
	var dir: String=_data_root.path_join(tag+"_protected")
	_check(DirAccess.make_dir_recursive_absolute(dir)==OK,"isolated corrupt-save fixture directory")
	var path: String=dir.path_join(SaveServiceScript.SAVE_FILE)
	var file:=FileAccess.open(path,FileAccess.WRITE)
	_check(file!=null,"own malformed save can be created")
	if file==null:
		holder.queue_free()
		return
	file.store_string("{broken")
	file.close()
	var app: Control=await _spawn(holder,dir)
	app.set_process(false)
	var home: Control=app.get("_home")
	_check(app.get("save_locked") and FileAccess.get_file_as_string(path)=="{broken",tag+": protected bytes never overwritten on load")
	_geometry(holder,app,tag+" protected")
	await _shot(holder,tag+"_home_10_protected_home.png")
	await _tap(holder,home,"HomeInfo")
	_check((app.get("_reset_button") as Control).is_visible_in_tree(),tag+": original archive/reset is reachable")
	await _shot(holder,tag+"_home_11_protected_detail.png")
	await _tap(holder,home,"HomeSave")
	_check(app.get("save_locked") and FileAccess.get_file_as_string(path)=="{broken",tag+": manual save retains protection")
	await _tap(holder,home,"ResetSaveButton")
	_check(not app.get("save_locked") and not (app.get("_banner") as Control).visible,tag+": original explicit archive/reset route works")
	var archived: bool=false
	for name in DirAccess.get_files_at(dir):
		if name.begins_with(SaveServiceScript.CORRUPT_PREFIX): archived=FileAccess.get_file_as_string(dir.path_join(name))=="{broken"
	_check(archived,tag+": original malformed bytes archived exactly")
	await _tap(holder,home,"HomeDetailsClose")
	_geometry(holder,app,tag+" reset")
	app.queue_free()
	await _frames(3)
	holder.queue_free()
	await _settle()
