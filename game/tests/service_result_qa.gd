extends "res://tests/bowl_editor_qa.gd"
## Actual pointer navigation and settlement/save boundaries. State preparation
## uses public transactions; only this isolated session clock is fast-forwarded.
const SalesFixture = preload("res://tests/harbor_foraging_tests.gd")
const SalesCheck = preload("res://scripts/domain/data_check.gd")


func _run() -> void:
	var profiles: Array=[{"tag":"portrait","size":Vector2i(390,844)},{"tag":"desktop","size":Vector2i(1280,800)}]
	if OS.get_cmdline_user_args().has("--service-compact"):
		profiles=[{"tag":"compact","size":Vector2i(390,750)}]
	for profile in profiles:
		await _sales(str(profile["tag"]),profile["size"])
	print("SERVICE RESULT mode=%s checks=%d failures=%d" % ["layout-only" if _layout_only else "capture",_checks,_failures.size()])
	for failure in _failures: printerr("FAIL: "+failure)
	quit(0 if _failures.is_empty() else 1)


func _json(app: Node) -> String:
	return JSON.stringify(app.get("state").to_dict(),"",true)


func _bounds(view: Control, holder: SubViewport, tag: String) -> void:
	var panel: Control=view.find_child("ResultPanel",true,false)
	var close: Control=view.find_child("ResultOkButton",true,false)
	var scroll: Control=view.find_child("ResultScroll",true,false)
	_check(Rect2(Vector2.ZERO,Vector2(holder.size)).encloses(panel.get_global_rect()),tag+": framed view within viewport")
	_check(panel.get_global_rect().encloses(close.get_global_rect()) and close.size.y>=44,tag+": fixed close target reachable")
	_check(scroll.size.y>=100 and scroll.get_global_rect().end.y<=close.get_global_rect().position.y,tag+": detail scroll stays above footer")
	var title: Control=view.find_child("ResultTitle",true,false)
	_check(panel.get_global_rect().encloses(title.get_global_rect()),tag+": heading remains inside padded frame")


func _complete(holder: SubViewport, app: Node, tag: String) -> Control:
	var st: Object=app.get("state")
	var before: String=_json(app)
	var wallet: int=st.wallet
	var day: int=st.day
	await _tap(holder,app,"StartServiceButton")
	_check(st.service_active() and _json(app)==before,tag+": starting never settles")
	_advance(app,6000.0)
	app.call("_process",0.0)
	await _settle()
	_check(st.day==day+1 and st.wallet==wallet+int(st.last_report["net"]),tag+": exact single net/day settlement")
	var after: String=_json(app)
	_check(not st.settle_service()["ok"] and _json(app)==after,tag+": second settlement refused")
	var view: Control=app.get("_service_result")
	_check(view.visible and view.get("_menus").size()==st.last_report.get("menus",[{}]).size(),tag+": actual current result view")
	_check((view.find_child("ResultNet",true,false) as Label).text==str(app.call("_won",int(st.last_report["net"]))),tag+": actual net in prominent figure")
	_bounds(view,holder,tag)
	return view


func _sales(tag: String, vp: Vector2i) -> void:
	var holder:=SubViewport.new()
	holder.size=vp
	holder.handle_input_locally=true
	holder.render_target_update_mode=SubViewport.UPDATE_ALWAYS
	root.add_child(holder)
	var dir: String=_data_root.path_join(tag+"_sales")
	_check(DirAccess.make_dir_recursive_absolute(dir)==OK,"isolated sales directory")
	var app: Node=await _spawn(holder,dir)
	app.set_process(false)
	var st: Object=app.get("state")
	app.call("_open_overlay",3)
	await _settle()
	_check((app.find_child("LastServiceReport",true,false) as Button).disabled,tag+": empty history disabled")
	app.call("_on_result_ok")
	app.call("_close_overlay")
	_check(st.set_draft_name("가게의 첫 라멘")["ok"] and st.taste()["ok"],tag+": real single menu tasting")
	var sold: Dictionary=st.draft_config.duplicate(true)
	app.call("_refresh_all")
	var view: Control=await _complete(holder,app,tag+" single")
	await _shot(holder,tag+"_sales_01_single.png")
	var unchanged: String=_json(app)
	await _tap(holder,view,"ResultMenu_0")
	_check(SalesCheck.same_config((view.find_child("ResultSoldDish",true,false) as Control).get("config"),sold),tag+": actual sold dish snapshot")
	await _shot(holder,tag+"_sales_02_menu.png")
	await _tap(holder,view,"ResultBack")
	await _tap(holder,view,"ResultCustomers")
	_check(view.get("_context").has("avg_stars"),tag+": actual live reactions available")
	await _shot(holder,tag+"_sales_03_customers.png")
	await _tap(holder,view,"ResultBack")
	await _tap(holder,view,"ResultCosts")
	await _shot(holder,tag+"_sales_04_costs.png")
	await _tap(holder,view,"ResultSaveStatus")
	_check((view.find_child("ResultLabel",true,false) as Label).is_visible_in_tree(),tag+": complete receipt is a real reachable depth")
	_bounds(view,holder,tag+" receipt")
	_check(_json(app)==unchanged,tag+": all details leave ledger unchanged")
	await _tap(holder,view,"ResultBack")
	var menu: Control=view.find_child("ResultMenu_0",true,false)
	(view.get("_scroll") as ScrollContainer).ensure_control_visible(menu)
	await _settle()
	await _drag_list(holder,menu.get_global_rect().get_center())
	_check(view.get("_page")=="summary" and _json(app)==unchanged,tag+": card swipe cancels navigation and payment")
	await _tap(holder,view,"ResultOkButton")
	_check(not view.visible,tag+": dismiss")
	_check(st.set_draft_choice("broth","broth_chicken")["ok"],tag+": actual subsequent draft edit")
	var edited: String=_json(app)
	app.call("_open_overlay",3)
	await _tap(holder,app,"LastServiceReport")
	await _tap(holder,view,"ResultMenu_0")
	var previous_dish: Control=view.find_child("ResultSoldDish",true,false) as Control
	_check(previous_dish!=null,tag+": reopened sold dish detail exists")
	if previous_dish==null:
		printerr("REOPEN DEBUG page=%s context=%s visible=%s" % [view.get("_page"),view.get("_context"),view.visible])
	else:
		_check(SalesCheck.same_config(previous_dish.get("config"),sold),tag+": old dish never becomes current draft")
	await _tap(holder,view,"ResultDevelop")
	if view.visible or not (app.get("_bowl_editor") as Control).is_visible_in_tree() or _json(app)!=edited:
		printerr("HANDOFF DEBUG visible=%s editor=%s state_equal=%s tab=%s" % [view.visible,(app.get("_bowl_editor") as Control).is_visible_in_tree(),_json(app)==edited,app.get("tabs").current_tab])
	_check(not view.visible and (app.get("_bowl_editor") as Control).is_visible_in_tree() and _json(app)==edited,tag+": explicit development handoff preserves draft/ledger")
	app.call("_close_overlay")
	_check(app.call("_persist"),tag+": edited isolated save")
	app.queue_free()
	await _frames(3)
	app=await _spawn(holder,dir)
	app.set_process(false)
	st=app.get("state")
	app.call("_open_overlay",3)
	await _tap(holder,app,"LastServiceReport")
	view=app.get("_service_result")
	_check(not view.get("_context").has("avg_stars"),tag+": restart cannot invent live satisfaction")
	await _tap(holder,view,"ResultMenu_0")
	_check(view.find_child("ResultSoldDish",true,false)==null,tag+": old single receipt cannot invent recipe snapshot")
	await _shot(holder,tag+"_sales_05_restored_single.png")
	await _tap(holder,view,"ResultOkButton")
	app.call("_close_overlay")
	# Match the fresh baseline's real expanded day and two menu configurations.
	var fixture:=SalesFixture.new()
	fixture.check=_check
	var prepared: Object=fixture.ready()
	_check(prepared.expand_shop()["ok"],tag+": actual expansion")
	var ids: Array=[]
	for record in prepared.records(): ids.append(int(record["record_id"]))
	_check(prepared.set_selling_menus(ids)["ok"] and st.load_from_dict(prepared.to_dict())=="",tag+": actual two-menu ledger")
	app.call("_refresh_all")
	view=await _complete(holder,app,tag+" pair")
	await _shot(holder,tag+"_sales_06_pair.png")
	var report: Dictionary=st.last_report.duplicate(true)
	_check(int(report["menus"][0]["margin"])+int(report["menus"][1]["margin"])-int(report["overhead"])==int(report["net"]),tag+": common overhead deducted only once")
	await _tap(holder,view,"ResultMenu_1")
	_check(SalesCheck.same_config((view.find_child("ResultSoldDish",true,false) as Control).get("config"),report["menus"][1]["config"]),tag+": second actual sold dish")
	await _shot(holder,tag+"_sales_07_pair_detail.png")
	holder.size=Vector2i(390,750)
	await _settle()
	_bounds(view,holder,tag+" live compact resize")
	holder.size=vp
	await _settle()
	await _tap(holder,view,"ResultBack")
	await _tap(holder,view,"ResultCustomers")
	await _shot(holder,tag+"_sales_08_pair_customers.png")
	await _tap(holder,view,"ResultOkButton")
	var stable: String=_json(app)
	app.call("_start_service")
	app.call("_abort_service","시험 중단")
	_check(_json(app)==stable and not view.visible,tag+": abort has no settlement/reward")
	app.queue_free()
	await _frames(3)
	app=await _spawn(holder,dir)
	app.set_process(false)
	st=app.get("state")
	app.call("_show_service_report")
	view=app.get("_service_result")
	await _tap(holder,view,"ResultMenu_1")
	_check(view.find_child("ResultSoldDish",true,false)!=null and not view.get("_context").has("avg_stars"),tag+": saved expanded snapshot survives without invented live stats")
	await _shot(holder,tag+"_sales_09_restored_pair.png")
	app.queue_free()
	await _frames(3)
	await _zero_and_failure(holder,tag)
	holder.queue_free()
	await _frames(3)


func _zero_and_failure(holder: SubViewport, tag: String) -> void:
	var dir: String=_data_root.path_join(tag+"_zero")
	_check(DirAccess.make_dir_recursive_absolute(dir)==OK,"isolated zero-sale directory")
	var app: Node=await _spawn(holder,dir)
	app.set_process(false)
	var st: Object=app.get("state")
	_check(st.set_draft_price(30000)["ok"] and st.taste()["ok"],tag+": real zero-demand expensive menu")
	app.call("_refresh_all")
	var view: Control=await _complete(holder,app,tag+" loss")
	_check(int(st.last_report["units"])==0 and int(st.last_report["net"])==-3000,tag+": actual zero sales and operating loss")
	await _shot(holder,tag+"_sales_10_loss.png")
	await _tap(holder,view,"ResultCustomers")
	_check(float(view.get("_context")["avg_stars"])==0.0,tag+": actual no-service rating remains zero, no invented praise")
	await _tap(holder,view,"ResultOkButton")
	var saver: Object=app.get("saver")
	_check(app.call("_persist"),tag+": save before real failure")
	var disk: String=FileAccess.get_file_as_string(saver.main_path())
	_check(DirAccess.make_dir_recursive_absolute(saver.tmp_path())==OK,tag+": own temporary conflict")
	view=await _complete(holder,app,tag+" failed save")
	_check(FileAccess.get_file_as_string(saver.main_path())==disk,tag+": failed save never overwrites disk")
	_check((view.find_child("ResultSaveStatus",true,false) as Button).text.contains("저장하지 못했"),tag+": visible failure status")
	await _tap(holder,view,"ResultSaveStatus")
	_check((view.find_child("ResultNote",true,false) as Label).text.contains("지금 닫으면") and not (view.find_child("ResultNote",true,false) as Label).text.contains("저장했어요"),tag+": full truthful failure warning")
	await _shot(holder,tag+"_sales_11_save_failure.png")
	_bounds(view,holder,tag+" failure")
	_check(DirAccess.remove_absolute(saver.tmp_path())==OK and app.call("_persist"),tag+": recover own conflict and save")
	await _tap(holder,view,"ResultOkButton")
	app.call("_show_service_report")
	_check((view.find_child("ResultSaveStatus",true,false) as Button).text.contains("저장했어요"),tag+": reopened status reflects successful recovery")
	app.queue_free()
	await _frames(3)
