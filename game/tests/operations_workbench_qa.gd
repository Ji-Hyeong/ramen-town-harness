extends "res://tests/bowl_editor_qa.gd"
## Public transactions prepare every earned fixture. Actual pointer events,
## isolated real disk failures and fresh scene restarts verify the new views.
const Fixture = preload("res://tests/harbor_foraging_tests.gd")
const ConfigCheck = preload("res://scripts/domain/data_check.gd")


func _run() -> void:
	var profiles: Array=[{"tag":"portrait","size":Vector2i(390,844)},{"tag":"desktop","size":Vector2i(1280,800)}]
	if OS.get_cmdline_user_args().has("--operations-compact"): profiles=[{"tag":"compact","size":Vector2i(390,750)}]
	for profile in profiles: await _flow(profile["tag"],profile["size"])
	print("OPERATIONS mode=%s checks=%d failures=%d" % ["layout-only" if _layout_only else "capture",_checks,_failures.size()])
	for failure in _failures: printerr("FAIL: "+failure)
	quit(0 if _failures.is_empty() else 1)


func _json(st: Object) -> String:
	return JSON.stringify(st.to_dict(),"",true)


func _update(app: Node) -> void:
	app.call("_refresh_all")
	app.call("_sync_bowl_editor")
	await _settle()


func _bounds(holder: SubViewport, view: Control, tag: String) -> void:
	var frame: Control=view.find_child("OpsFrame",true,false)
	_check(Rect2(Vector2.ZERO,Vector2(holder.size)).encloses(frame.get_global_rect()),tag+": native frame fits")
	for name in ["OpsBack","OpsPrimary","OpsSecondary"]:
		var button: Control=view.find_child(name,true,false)
		_check(frame.get_global_rect().encloses(button.get_global_rect()) and button.size.y>=44,tag+": fixed usable "+name)
	var scroll: Control=view.get("_scroll")
	_check(scroll.size.y>=120 and scroll.get_global_rect().end.y<=(view.get("_primary") as Control).get_global_rect().position.y,tag+": readable scroll above fixed action")
	for candidate in view.find_children("*","Label",true,false):
		var label: Label=candidate
		if label.is_visible_in_tree():
			_check(_text_height_fits(label),tag+": text fits "+label.name)
			var parent: Node=label.get_parent()
			while parent!=null and not parent is Button: parent=parent.get_parent()
			if parent is Button and str(parent.name).begins_with("OpsRecord_"):
				_check(parent.get_global_rect().grow(-10).encloses(label.get_global_rect()),tag+": actual card text has breathing room")


func _taste(st: Object, config: Dictionary, title: String) -> int:
	for record in st.records():
		if ConfigCheck.same_config(record["config"],config):
			_check(st.select_record(record["record_id"])["ok"],"select real existing witness")
			return record["record_id"]
	st.start_new_recipe()
	for slot in ["broth","tare","oil","noodle","cook"]: _check(st.set_draft_choice(slot,config[slot])["ok"],"public witness ingredient "+slot)
	_check(st.set_draft_toppings(config["toppings"])["ok"],"public witness toppings")
	_check(st.set_draft_price(config["price"])["ok"] and st.set_draft_name(title)["ok"],"public witness price/title")
	var result: Dictionary=st.taste()
	_check(result["ok"],"real witness tasting: "+str(result.get("message","")))
	return st.selected_record_id


func _flow(tag: String, vp: Vector2i) -> void:
	var holder:=SubViewport.new()
	holder.size=vp
	holder.handle_input_locally=true
	holder.render_target_update_mode=SubViewport.UPDATE_ALWAYS
	root.add_child(holder)
	var dir: String=_data_root.path_join(tag)
	_check(DirAccess.make_dir_recursive_absolute(dir)==OK,"isolated operations directory")
	var app: Control=await _spawn(holder,dir)
	app.set_process(false)
	var st: Object=app.get("state")
	app.call("_open_overlay",2)
	await _settle()
	var view: Control=app.get("_operations_view")
	_check(view.visible and not (app.get("_drawer_margin") as Control).visible,tag+": current native notebook replaces legacy drawer")
	_bounds(holder,view,tag+" empty")
	await _shot(holder,tag+"_01_empty.png")
	await _tap(holder,view,"OpsTab_research")
	await _tap(holder,view,"OpsResearch_dohyun_advanced")
	_check((view.get("_primary") as Button).disabled,tag+": true advanced research lock")
	_bounds(holder,view,tag+" locked")
	await _shot(holder,tag+"_02_locked.png")
	await _tap(holder,view,"OpsBack")
	var fixture:=Fixture.new()
	fixture.check=_check
	_check(st.load_from_dict(fixture.ready().to_dict())=="",tag+": publicly earned rank2 fixture")
	await _update(app)
	await _tap(holder,view,"OpsTab_notebook")
	_bounds(holder,view,tag+" notebook")
	await _shot(holder,tag+"_03_notebook.png")
	var before: String=_json(st)
	var acknowledgements: int=app.get("_juice").acknowledgement_count()
	await _drag_list(holder,(view.find_child("OpsRecord_2",true,false) as Control).get_global_rect().get_center())
	_check(view.get("_page")=="list" and _json(st)==before and app.get("_juice").acknowledgement_count()==acknowledgements,tag+": dragging actual bowl card cancels navigation/action feedback")
	await _tap(holder,view,"OpsRecord_2")
	_check(view.get("_page")=="detail" and _json(st)==before,tag+": record inspection is read only")
	_check(app.get("_juice").acknowledgement_count()>acknowledgements,tag+": actual card tap receives established feedback")
	_bounds(holder,view,tag+" record")
	await _shot(holder,tag+"_04_record.png")
	var replacement: Dictionary=st.set_draft_price(int(st.get_record(2)["config"]["price"])+500)
	await _tap(holder,view,"OpsTarget")
	_check(replacement["ok"] and st.selected_record_id==2 and st.draft_config["price"]==st.get_record(2)["config"]["price"] and view.visible and (view.get("_policy") as Label).text.contains("초안"),tag+": explicitly warned record loading replaces draft and retains notebook")
	await _tap(holder,view,"OpsTab_research")
	await _shot(holder,tag+"_05_research.png")
	await _tap(holder,view,"OpsResearch_dohyun_basic")
	var wallet: int=st.wallet
	await _shot(holder,tag+"_06_research_detail.png")
	await _tap(holder,view,"OpsPrimary")
	_check(st.research_completed_ids().has("dohyun_basic") and st.wallet==wallet+2000,tag+": actual research reward exactly once")
	_check((view.get("_primary") as Button).disabled and view.find_child("OpsResearchReceipt",true,false)!=null,tag+": completed receipt/disabled action")
	before=_json(st)
	app.call("_on_research_submit","dohyun_basic")
	_check(_json(st)==before,tag+": repeat submission cannot duplicate reward")
	await _update(app)
	await _shot(holder,tag+"_07_research_receipt.png")
	await _tap(holder,view,"OpsTab_selling")
	await _tap(holder,view,"OpsRecord_2")
	await _tap(holder,view,"OpsPrimary")
	_check(st.pinned_menu_ids()==[2],tag+": native selling pin invokes actual handler")
	_check(st.expand_shop()["ok"],tag+": real paid expansion opens second selling slot")
	await _update(app)
	await _tap(holder,view,"OpsBack")
	await _tap(holder,view,"OpsRecord_1")
	await _tap(holder,view,"OpsPrimary")
	_check(st.pinned_menu_ids()==[2,1] and st.selling_records().size()==2,tag+": native second-menu addition preserves first selling dish")
	await _tap(holder,view,"OpsBack")
	_bounds(holder,view,tag+" two menus")
	await _shot(holder,tag+"_23_selling_two.png")
	await _tap(holder,view,"OpsForecastLink")
	_bounds(holder,view,tag+" forecast")
	await _shot(holder,tag+"_08_forecast.png")
	await _tap(holder,view,"OpsBack")
	await _tap(holder,view,"OpsAuto")
	_check(st.pinned_menu_ids().is_empty(),tag+": automatic selling resumes without replacing records")
	await _tap(holder,view,"OpsTab_stories")
	await _shot(holder,tag+"_09_stories.png")
	await _tap(holder,view,"OpsStory_dohyun")
	before=_json(st)
	await _tap(holder,view,"OpsChoice_hearty")
	_check(_json(st)==before and st.story_arc("dohyun").is_empty(),tag+": first irreversible route tap only arms")
	await _tap(holder,view,"OpsTab_research")
	_check(app.get("_story_armed")=="",tag+": switching sections cancels route confirmation")
	await _tap(holder,view,"OpsTab_stories")
	await _tap(holder,view,"OpsStory_dohyun")
	await _tap(holder,view,"OpsChoice_hearty")
	await _shot(holder,tag+"_10_story_confirm.png")
	await _tap(holder,view,"OpsChoice_hearty")
	_check(st.story_arc("dohyun")["route"]=="hearty",tag+": same second route tap commits")
	_bounds(holder,view,tag+" story")
	await _shot(holder,tag+"_11_story_progress.png")
	var story_record: int=_taste(st,StoryFixtures.WITNESSES["dohyun:hearty:0"],"단골의 든든한 그릇")
	_check(st.set_selling_menus([story_record])["ok"] and st.serve()["ok"],tag+": actual selected dish served after story start")
	await _update(app)
	wallet=st.wallet
	await _tap(holder,view,"OpsPrimary")
	_check(st.story_arc("dohyun")["receipts"].size()==1 and st.wallet==wallet+2000,tag+": actual first chapter receipt and once-only reward")
	await _shot(holder,tag+"_12_story_receipt.png")
	story_record=_taste(st,StoryFixtures.WITNESSES["dohyun:hearty:1"],"퇴근 뒤 든든한 그릇")
	_check(st.set_selling_menus([story_record])["ok"] and st.serve()["ok"],tag+": fresh second-chapter dish and actual new service")
	await _update(app)
	wallet=st.wallet
	await _tap(holder,view,"OpsPrimary")
	_check(st.story_arc("dohyun")["receipts"].size()==2 and st.wallet==wallet+4000 and view.find_child("OpsStoryEnding",true,false)!=null,tag+": actual ending with second once-only receipt")
	_bounds(holder,view,tag+" ending")
	await _shot(holder,tag+"_24_story_ending.png")
	before=_json(st)
	app.call("_on_story_complete","dohyun")
	_check(_json(st)==before,tag+": completed story cannot grant another reward")
	var contest_record: int=_taste(st,{"broth":"broth_dashi","tare":"tare_shio","oil":"oil_scallion","noodle":"noodle_thin","toppings":["topping_nori"],"cook":"cook_firm","price":9000},"맑은 대회 그릇")
	_check(st.set_selling_menus([])["ok"],tag+": clear pin through public transaction")
	await _update(app)
	await _tap(holder,view,"OpsTab_contests")
	await _shot(holder,tag+"_13_contests.png")
	await _tap(holder,view,"OpsContest_clear_bowl")
	wallet=st.wallet
	await _shot(holder,tag+"_14_contest_detail.png")
	await _tap(holder,view,"OpsPrimary")
	_check(st.wallet==wallet-2000+18000 and st.contest_progress()["history"].size()==1,tag+": actual entry fee/gold prize exact once")
	_check((view.get("_primary") as Button).disabled,tag+": judging action disabled")
	_check(view.find_child("OpsContestResult",true,false)==null,tag+": judging does not reveal outcome before presentation finishes")
	await _shot(holder,tag+"_15_judging.png")
	app.call("advance_contest",2.0)
	app.call("_sync_bowl_editor")
	await _settle()
	_bounds(holder,view,tag+" contest result")
	await _shot(holder,tag+"_16_contest_result.png")
	var saver: Object=app.get("saver")
	var disk: String=FileAccess.get_file_as_string(saver.main_path())
	_check(DirAccess.make_dir_recursive_absolute(saver.tmp_path())==OK,tag+": scoped real save failure")
	wallet=st.wallet
	await _tap(holder,view,"OpsMagazine")
	_check(st.wallet==wallet+3000 and st.contest_progress()["articles"].size()==1 and FileAccess.get_file_as_string(saver.main_path())==disk,tag+": magazine reward in memory once; failed save preserves old disk")
	_check((view.find_child("OpsNotice",true,false) as Button).text.contains("저장하지 못"),tag+": native persistent actual save failure")
	await _shot(holder,tag+"_17_save_failure.png")
	before=_json(st)
	app.call("_on_magazine_accept","clear_bowl")
	_check(_json(st)==before,tag+": failed-save reward is never granted again")
	_check(DirAccess.remove_absolute(saver.tmp_path())==OK,tag+": remove only own empty conflict")
	app.call("_sync_bowl_editor")
	await _tap(holder,view,"OpsNotice")
	await _tap(holder,view,"OpsPrimary")
	_check(not app.get("_save_error_shown"),tag+": actual manual save recovery")
	await _shot(holder,tag+"_18_save_recovery.png")
	await _tap(holder,view,"OpsTab_notebook")
	await _tap(holder,view,"OpsMap")
	_bounds(holder,view,tag+" map")
	await _shot(holder,tag+"_19_map.png")
	await _tap(holder,view,"OpsBack")
	await _tap(holder,view,"OpsRecord_%d" % contest_record)
	before=_json(st)
	await _tap(holder,view,"OpsDelete")
	_check(_json(st)==before,tag+": first delete only arms")
	await _tap(holder,view,"OpsBack")
	_check(app.get("_pending_delete_id")==0 and _json(st)==before,tag+": back cancels destructive confirmation")
	var before_menus: int=st.menu_count()
	var before_records: int=st.record_count()
	for i in 10:
		_check(st.set_draft_price(9500+i*500)["ok"] and st.taste()["ok"],tag+": actual same-menu revision")
	await _update(app)
	_check(st.menu_count()==before_menus and st.record_count()==before_records+10,tag+": revisions do not consume another menu family")
	await _tap(holder,view,"OpsFilter_history")
	_check(view.find_children("OpsRecord_*","Button",true,false).size()==8,tag+": actual history materializes at most eight cards")
	var latest_id: int=st.selected_record_id
	await _tap(holder,view,"OpsRecord_%d" % latest_id)
	_check((view.find_child("ComparisonLabel",true,false) as Label).text.contains("→"),tag+": actual adjacent-revision comparison is visible")
	_bounds(holder,view,tag+" comparison")
	await _shot(holder,tag+"_21_comparison.png")
	await _tap(holder,view,"OpsBack")
	await _tap(holder,view,"OpsOlder")
	_check(view.find_children("OpsRecord_*","Button",true,false).size()==before_records+2 and view.get("_index")==1,tag+": older history page is bounded and reachable")
	_bounds(holder,view,tag+" history page")
	await _shot(holder,tag+"_22_history_page.png")
	var list_scroll: ScrollContainer=view.get("_scroll")
	list_scroll.scroll_vertical=90
	await _settle()
	await _tap(holder,view,"OpsRecord_2")
	await _tap(holder,view,"OpsBack")
	_check(list_scroll.scroll_vertical>0,tag+": back restores actual scrolled list position")
	await _tap(holder,view,"OpsRecord_2")
	var deleting: int=st.record_count()
	await _tap(holder,view,"OpsDelete")
	await _tap(holder,view,"OpsDelete")
	_check(st.get_record(2).is_empty() and st.record_count()==deleting-1,tag+": explicit second delete removes only requested revision")
	_check(st.contest_progress()["history"].size()==1 and st.story_arc("dohyun")["receipts"].size()==2,tag+": history cleanup preserves earned receipts")
	await _tap(holder,view,"OpsBack")
	await _tap(holder,view,"OpsBack")
	_check(not view.visible,tag+": native close immediately releases home input")
	await _tap(holder,app.get("_home"),"HomeInfo")
	await _tap(holder,app.get("_home"),"HomeGrowth")
	_check((app.get("_growth_view") as Control).visible and not view.visible,tag+": next native page has exclusive input")
	await _tap(holder,app.get("_growth_view"),"GrowthBack")
	var saved: String=_json(st)
	app.queue_free()
	await _frames(4)
	app=await _spawn(holder,dir)
	app.set_process(false)
	_check(_json(app.get("state"))==saved,tag+": fresh scene loads exact saved rewards/records/route")
	app.call("_open_overlay",7)
	await _settle()
	view=app.get("_operations_view")
	await _tap(holder,view,"OpsContest_clear_bowl")
	_check(view.find_child("OpsMagazineStatus",true,false)!=null and (view.get("_primary") as Button).disabled,tag+": restart retains immutable article and gold completion")
	await _shot(holder,tag+"_20_restart.png")
	holder.queue_free()
	await _frames(4)
