extends "res://tests/development_cycle_qa.gd"
## New-game acceptance uses actual elapsed manufacturing/tasting and public
## UI transactions. Only the isolated sales clock is accelerated. These flows
## cannot establish the fun or duration of a human's first thirty minutes.
const Journey=preload("res://scripts/ui/kitchen_journey.gd")
const Evaluation=preload("res://scripts/domain/recipe_evaluator.gd")
var _finished: int=0

func _run() -> void:
	for profile in [{"tag":"portrait","size":Vector2i(390,844)},{"tag":"desktop","size":Vector2i(1280,800)},{"tag":"compact","size":Vector2i(390,750)}]:
		await _journey(profile["tag"],profile["size"])
	_check(_finished==3,"all three real journeys reached the final assertion")
	print("FIRST MENU JOURNEY checks=%d failures=%d mode=%s" % [_checks,_failures.size(),"layout" if _layout_only else "capture"])
	for failure in _failures: printerr("FAIL: "+failure)
	quit(0 if _failures.is_empty() else 1)

func _state_json(st: Object) -> String:
	return JSON.stringify(st.to_dict(),"",true)

func _journey(tag: String, vp: Vector2i) -> void:
	var holder:=SubViewport.new()
	holder.size=vp
	holder.handle_input_locally=true
	holder.render_target_update_mode=SubViewport.UPDATE_ALWAYS
	root.add_child(holder)
	var dir: String=_data_root.path_join(tag+"_journey")
	_check(DirAccess.make_dir_recursive_absolute(dir)==OK,tag+": fresh isolated storage")
	var app: Node=await _spawn(holder,dir)
	app.set("state",ActualState.new())
	var st: Object=app.get("state")
	app.call("_refresh_all")
	await _settle()
	var before: String=_state_json(st)
	_check(not st.broth_ready() and not st.noodle_ready(),tag+": no free prepared broth or noodles")
	await _shot(holder,tag+"_journey_01_first_goal.png")
	await _tap(holder,app,"DevButton")
	var editor: Control=app.get("_bowl_editor")
	_check(editor.visible and (editor.get("_modal") as Control).get_meta("view_kind","")=="broth",tag+": current home action opens real raw broth workshop")
	_check(_state_json(st)==before,tag+": home navigation never pays or changes recipe")
	await _tap(holder,editor,"BrothAdd_chicken_bone")
	await _tap(holder,editor,"BrothAdd_onion")
	await _tap(holder,editor,"EditorDetailApply")
	await _wait_component(st,"broth")
	before=_state_json(st)
	await _tap(holder,editor,"EditorDetailsBack")
	app.call("_close_overlay")
	app.call("_sync_bowl_editor")
	await _tap(holder,app,"DevButton")
	_check((editor.get("_modal") as Control).get_meta("view_kind","")=="component_complete" and _state_json(st)==before,tag+": finished broth resumes explicit application without another payment")
	await _tap(holder,editor,"EditorDetailApply")
	await _tap(holder,editor,"NoodleChoose_strong")
	await _tap(holder,editor,"EditorDetailApply")
	await _wait_component(st,"noodle")
	await _tap(holder,editor,"EditorDetailApply")
	await _tap(holder,editor,"EditorAdd_topping_egg")
	var wallet: int=st.wallet
	await _tap(holder,editor,"EditorTaste")
	var deadline: int=Time.get_ticks_msec()+12000
	while app.call("work_active") and Time.get_ticks_msec()<deadline: await process_frame
	await _settle()
	_check(st.record_count()==1 and st.wallet<wallet,tag+": first paid tasting completed exactly once")
	var first: Dictionary=st.get_record(st.last_feedback_record_id)
	_check(not Journey.comparison(first)["available"],tag+": first tasting has no invented comparison")
	await _shot(holder,tag+"_journey_02_first_tasting.png")
	app.call("_close_overlay")
	app.call("_sync_bowl_editor")
	before=_state_json(st)
	await _tap(holder,app,"DevButton")
	_check(app.get("tabs").current_tab==3 and not st.service_active() and _state_json(st)==before,tag+": first sales guidance only opens selling preparation")
	await _shot(holder,tag+"_journey_03_selling.png")
	app.call("_close_overlay")
	app.call("_sync_bowl_editor")
	wallet=st.wallet
	var day: int=st.day
	await _tap(holder,app,"StartServiceButton")
	_check(st.service_active() and st.wallet==wallet and st.day==day,tag+": explicit sales start never settles early")
	app.call("_on_journey_action","explore")
	_check(st.service_active() and not app.get("_overlay").visible,tag+": stale goal action cannot navigate during sales")
	_advance(app,6000.0)
	app.call("_process",0.0)
	await _settle()
	var report: Control=app.get("_service_result")
	_check(report.visible and st.day==day+1 and st.wallet==wallet+int(st.last_report["net"]),tag+": actual completed sales settle exact net and day once")
	before=_state_json(st)
	_check(not st.settle_service()["ok"] and _state_json(st)==before,tag+": repeated settlement rejected")
	await _shot(holder,tag+"_journey_04_sales_choices.png")
	await _tap(holder,report,"ResultNextGoals")
	for name in ["ResultJourney_improve","ResultJourney_explore","ResultJourney_research"]:
		var choice: Control=report.find_child(name,true,false)
		_check(choice!=null and choice.size.y>=78,tag+": actual usable next choice "+name)
	var improve: Button=report.find_child("ResultJourney_improve",true,false)
	(report.get("_scroll") as ScrollContainer).ensure_control_visible(improve)
	await _settle()
	var card: Control=improve.get_parent().get_parent()
	for name in ["JourneyTitle","JourneyHint"]:
		var words: Label=card.find_child(name,true,false)
		_check(card.get_global_rect().grow(-9).encloses(words.get_global_rect()) and _text_height_fits(words),tag+": real next-choice text fits frame padding "+name)
	await _shot(holder,tag+"_journey_04b_choices.png")
	var acks: int=app.get("_juice").acknowledgement_count()
	await _drag_list(holder,improve.get_global_rect().get_center())
	_check(report.visible and _state_json(st)==before and app.get("_juice").acknowledgement_count()==acks,tag+": dragging a goal cancels both navigation and success feedback")
	(report.get("_scroll") as ScrollContainer).ensure_control_visible(improve)
	await _settle()
	_point(holder,improve.get_global_rect().get_center(),true)
	await _settle()
	_check((card.find_child("JourneyHint",true,false) as Label).get_theme_color("font_color")==Color.WHITE and _state_json(st)==before,tag+": held goal is readable and inert")
	await _shot(holder,tag+"_journey_04c_pressed.png")
	_point(holder,improve.get_global_rect().get_center(),false)
	await _settle()
	_check(app.get("_juice").acknowledgement_count()>acks,tag+": real goal click receives existing feedback")
	_check(editor.visible and int(editor.get("_mode"))==1 and _state_json(st)==before,tag+": improve route shows the actual paid tasting without replacing the current draft")
	_check(int(editor.get("_result_customer"))==People.ids().find(str(Journey.choices(st)[0]["customer"])),tag+": improvement opens the same observed customer's reaction as its card")
	await _tap(holder,editor,"EditorDevelopAgain")
	if editor.get("_modal")!=null: await _tap(holder,editor,"EditorDetailsBack")
	await _tap(holder,editor,"EditorRemove_0")
	await _tap(holder,editor,"EditorAdd_topping_egg")
	await _tap(holder,editor,"EditorTaste")
	deadline=Time.get_ticks_msec()+12000
	while app.call("work_active") and Time.get_ticks_msec()<deadline: await process_frame
	await _settle()
	var second: Dictionary=st.get_record(st.last_feedback_record_id)
	_check(st.record_count()==2 and int(second["version"])==2 and Journey.comparison(second)["available"],tag+": one repeated topping creates a genuinely paid comparable revision")
	before=_state_json(st)
	await _tap(holder,editor,"EditorRevisionSummary")
	var panel: Control=editor.get("_modal")
	_check(panel!=null,tag+": revision summary opened a real modal")
	if panel==null:
		app.queue_free()
		holder.queue_free()
		return
	_check(panel.find_child("JourneyBeforeDish",true,false)!=null and panel.find_child("JourneyAfterDish",true,false)!=null,tag+": comparison shows actual tasted dishes")
	_check(_state_json(st)==before,tag+": reading comparison never modifies draft or knowledge")
	await _shot(holder,tag+"_journey_05_revision.png")
	await _tap(holder,editor,"EditorDetailsBack")
	app.call("_close_overlay")
	app.call("_sync_bowl_editor")
	var first_report: Dictionary=st.last_report.duplicate(true)
	wallet=st.wallet
	await _tap(holder,app,"StartServiceButton")
	_advance(app,6000.0)
	app.call("_process",0.0)
	await _settle()
	_check(st.wallet==wallet+int(st.last_report["net"]) and st.last_report["day"]==int(first_report["day"])+1,tag+": revised-menu service uses another real single settlement")
	before=_state_json(st)
	await _tap(holder,report,"ResultSalesComparison")
	_check((report.find_child("SalesCompareUnits_0",true,false) as Label).text=="%d그릇" % first_report["units"],tag+": sales baseline is the actual earlier receipt")
	_check((report.find_child("SalesCompareNet_1",true,false) as Label).text==str(app.call("_won",int(st.last_report["net"]))),tag+": current comparison shows actual net after operating costs")
	_check(_state_json(st)==before,tag+": sales comparison is read-only")
	await _shot(holder,tag+"_journey_05b_sales_comparison.png")
	app.call("_on_result_ok")
	await _tap(holder,app,"DevButton")
	_check(editor.get("_modal")!=null,tag+": after sale home opens a choice of next experiments")
	await _shot(holder,tag+"_journey_06_next_goals.png")
	await _tap(holder,editor,"JourneyChoice_explore")
	_check(app.get("_exploration_view").visible and not st.exploration_active() and _state_json(st)==before,tag+": choosing exploration only browses real locations without paying or replacing recipe")
	await _shot(holder,tag+"_journey_07_explore.png")
	app.call("_close_overlay")
	app.call("_on_journey_action","research")
	_check(app.get("tabs").current_tab==4 and _state_json(st)==before,tag+": research choice is a read-only route to existing requirements")
	app.call("_close_overlay")
	app.call("_sync_bowl_editor")
	var restored:=ActualState.new()
	_check(app.get("saver").load_into(restored)["status"]=="ok" and restored.to_dict()==st.to_dict(),tag+": exact disk restart preserves real progress")
	_check(Journey.describe(restored)["action"]==Journey.describe(st)["action"],tag+": guidance resumes from saved facts without a new progress ledger")
	app.set("_service_result_context",{})
	app.set("_service_result_key","")
	app.call("_show_service_report")
	_check((report.get("_menus")[0]["config"] as Dictionary).is_empty(),tag+": old receipt never borrows a changed current recipe after restart")
	_check(report.find_child("ResultSalesComparison",true,false)==null,tag+": no fabricated previous sales comparison after restart")
	_check(_state_json(st)==before,tag+": reopening an old result is read-only")
	_finished+=1
	app.queue_free()
	await _settle()
	holder.queue_free()
	await _settle()
