extends "res://tests/ui_depth_feedback_tests.gd"
## Fresh native capture of the complete harbor journey at both actual viewport
## sizes. Semantic transactions and routed touch gestures remain separate.
const HarborTests = preload("res://tests/harbor_foraging_tests.gd")
const Harbor = preload("res://scripts/domain/harbor_foraging.gd")


func _run_profile(tag: String, vp: Vector2i, _scale: int) -> void:
	var holder := SubViewport.new()
	holder.size = vp
	holder.handle_input_locally = true
	holder.render_target_update_mode = SubViewport.UPDATE_ALWAYS
	root.add_child(holder)
	var directory := _data_root.path_join(tag + "_harbor")
	_check(DirAccess.make_dir_recursive_absolute(directory) == OK, tag + ": isolated harbor save")
	var app: Node = await _spawn(holder, directory)
	app.call("_open_overlay", 6)
	await _settle()
	_check(_btn_disabled(app, "HarborForagingDepart"), tag + ": fresh supplier lock")
	await _reachable(app, vp, "HarborForagingReason")
	await _shot(holder, tag + "_harbor_01_locked.png")
	var fixture := HarborTests.new()
	fixture.check = _check
	var prepared = fixture.ready()
	if not prepared.harbor_foraging_review()["can_start"]:
		app.queue_free()
		holder.queue_free()
		return
	app.set("state", prepared)
	_check(app.call("_persist"), tag + ": real unlocked state saved")
	app.call("_refresh_all")
	app.call("_open_overlay", 6)
	await _settle()
	_check(not _btn_disabled(app, "HarborForagingDepart"), tag + ": unlocked departure")
	var detail: Node = _find(app, "HarborMaterial_topping_scallop")
	var header := detail.get("header_button") as Button
	await _tap_control(holder, header)
	_check(detail.get("expanded"), tag + ": whole icon/title card opens with tap")
	var before: String = _dict_str(app)
	await _reachable(app, vp, "HarborFacts_topping_scallop")
	await _shot(holder, tag + "_harbor_02_details.png")
	_check(_dict_str(app) == before, tag + ": reading ingredient facts spends nothing")
	await _tap_control(holder, _find(app, "HarborForagingDepart"))
	app.set_process(false)
	_check(_state(app).call("exploration_active"), tag + ": actual departure starts")
	await _shot(holder, tag + "_harbor_03_travel.png")
	app.call("advance_travel", 100.0)
	await _settle()
	await _reachable(app, vp, "ExpeditionChoice_scallop_diver")
	await _shot(holder, tag + "_harbor_04_target.png")
	await _tap_control(holder, _find(app, "ExpeditionChoice_scallop_diver"))
	app.call("advance_travel", 100.0)
	await _settle()
	await _reachable(app, vp, "ExpeditionChoice_clean_three")
	await _shot(holder, tag + "_harbor_05_quantity.png")
	await _tap_control(holder, _find(app, "ExpeditionChoice_clean_three"))
	app.call("advance_travel", 100.0)
	await _settle()
	_check(_state(app).call("sample_stock", Harbor.IDS[1]) == 0, tag + ": reward waiting has no stock")
	await _shot(holder, tag + "_harbor_06_waiting.png")
	# Recreate the real scene from disk while a reward is pending.
	app.queue_free()
	await _frames(3)
	app = await _spawn(holder, directory)
	app.set_process(false)
	app.call("_open_overlay", 6)
	app.call("advance_travel", 100.0)
	await _settle()
	_check(_state(app).call("expedition")["stage"] == "result", tag + ": pending claim survives restart")
	await _tap_control(holder, _find(app, "ExpeditionCollect"))
	await _settle()
	_check(_state(app).call("sample_stock", Harbor.IDS[1]) == 3, tag + ": real collect gives3")
	_check(_btn_disabled(app, "HarborForagingDepart"), tag + ": shared daily departure stays spent")
	await _reachable(app, vp, "HarborLatestLab")
	await _shot(holder, tag + "_harbor_07_received.png")
	before = _dict_str(app)
	await _tap_control(holder, _find(app, "HarborLatestLab"))
	await _settle()
	_check((app.get("tabs") as TabContainer).current_tab == 0 and _dict_str(app) == before, tag + ": handoff opens lab without changing edited draft")
	await _shot(holder, tag + "_harbor_08_workbench.png")
	var state: Object = _state(app)
	_check(state.call("set_draft_toppings", [Harbor.IDS[1], Harbor.IDS[1], Harbor.IDS[1]])["ok"], tag + ": actual repeat portions")
	app.call("_refresh_all")
	_press(app, "DevButton")
	await _settle()
	await _shot(holder, tag + "_harbor_09_triple_dish.png")
	before = _dict_str(app)
	_press(app, "QuickTasteButton")
	_check(app.call("work_active"), tag + ": real cooking begins")
	app.call("_on_harbor_foraging_depart")
	app.call("_open_sample_lab", Harbor.IDS[1])
	_check(_dict_str(app) == before, tag + ": forced callbacks cannot bypass cooking lock")
	_check(app.call("cancel_work"), tag + ": trial cancellation")
	_check(_dict_str(app) == before and state.call("sample_stock", Harbor.IDS[1]) == 3, tag + ": cancel preserves all samples/money")
	_press(app, "QuickTasteButton")
	app.call("advance_work", 12.0)
	await _settle()
	_check(state.call("sample_stock", Harbor.IDS[1]) == 0, tag + ": completed recipe consumes3")
	_overflow(app, vp, tag + " harbor result")
	await _shot(holder, tag + "_harbor_10_result.png")
	_check(state.call("serve")["ok"] and state.call("sample_stock", Harbor.IDS[1]) == 0, tag + ": actual sale at zero research stock")
	_check(state.call("start_harbor_foraging")["ok"], tag + ": next day supports revisit")
	_check(state.call("advance_expedition", "sardine_boat")["ok"], tag + ": broth target")
	_check(state.call("advance_expedition", "take_one")["ok"], tag + ": inexpensive quantity")
	_check(state.call("finish_expedition")["ok"], tag + ": broth claim")
	app.call("_persist")
	app.call("_refresh_all")
	app.call("_open_overlay", 6)
	await _settle()
	await _reachable(app, vp, "HarborLatestLab")
	await _shot(holder, tag + "_harbor_11_broth.png")
	await _tap_control(holder, _find(app, "HarborLatestLab"))
	await _settle()
	_check(state.call("set_draft_choice", "broth", Harbor.IDS[0])["ok"], tag + ": select discovered broth")
	_check(state.call("set_draft_toppings", ["topping_nori"])["ok"], tag + ": remove used scallops")
	app.call("_refresh_all")
	await _settle()
	_overflow(app, vp, tag + " harbor workbench")
	await _shot(holder, tag + "_harbor_12_broth_dish.png")
	app.queue_free()
	await _frames(3)
	holder.queue_free()
	await _frames(3)
