extends "res://tests/exploration_workbench_qa.gd"
## Fresh native-rendered journeys. Public fixtures only earn progression; all
## travel choices, reward claims and editor handoffs below use pointer input.
const MountainFixture=preload("res://tests/mountain_foraging_tests.gd")
const FoodArt=preload("res://scripts/ui/bowl_editor_art.gd")


func _run() -> void:
	var profiles: Array=[{"tag":"portrait","size":Vector2i(390,844)},{"tag":"desktop","size":Vector2i(1280,800)}]
	if OS.get_cmdline_user_args().has("--mountain-compact"): profiles=[{"tag":"compact","size":Vector2i(390,750)}]
	for profile in profiles: await _mountain(profile["tag"],profile["size"])
	print("MOUNTAIN FORAGING mode=%s checks=%d failures=%d" % ["layout-only" if _layout_only else "capture",_checks,_failures.size()])
	for failure in _failures: printerr("FAIL: "+failure)
	quit(0 if _failures.is_empty() else 1)


func _check_mountain_layout(view: Control, holder: SubViewport, tag: String) -> void:
	_layout_checks(view,holder,tag)
	for node in view.find_children("*","Label",true,false):
		var label: Label=node
		if label.is_visible_in_tree(): _check(_text_height_fits(label),tag+": complete text height "+label.name)


func _mountain(tag: String, vp: Vector2i) -> void:
	var holder:=SubViewport.new()
	holder.size=vp
	holder.handle_input_locally=true
	holder.render_target_update_mode=SubViewport.UPDATE_ALWAYS
	holder.set_meta("qa_tag",tag)
	root.add_child(holder)
	var dir: String=_data_root.path_join(tag+"_mountain")
	_check(DirAccess.make_dir_recursive_absolute(dir)==OK,"isolated mountain save directory")
	var app: Node=await _spawn(holder,dir)
	app.set_process(false)
	var st: Object=app.get("state")
	app.call("_open_overlay",6)
	var view: Control=await _show(app)
	var before: String=_state_json(app)
	await _tap(holder,view,"ExploreRegion_mountain")
	await _tap(holder,view,"ExploreMode_sample")
	_check((view.get("_action") as Button).disabled and _state_json(app)==before,"locked mountain browsing pays nothing")
	_check((view.find_child("ExploreReason",true,false) as Label).text.contains("등급 3"),"rank3 and two suppliers explained")
	_check_mountain_layout(view,holder,tag+" locked")
	await _shot(holder,tag+"_mountain_01_locked.png")
	var fixture:=MountainFixture.new()
	fixture.check=_check
	var earned: Object=fixture.ready()
	_check(st.load_from_dict(earned.to_dict())=="","load publicly earned rank3/supplier state")
	_check(app.call("_persist"),"save isolated earned state")
	app.call("_refresh_all")
	view=await _show(app)
	_check_mountain_layout(view,holder,tag+" preview")
	await _shot(holder,tag+"_mountain_02_preview.png")
	before=_state_json(app)
	await _tap(holder,view,"ExploreMaterial_noodle_buckwheat")
	await _shot(holder,tag+"_mountain_03_material.png")
	await _tap(holder,view,"ExplorePrimary")
	_check(_state_json(app)==before,"ingredient inspection changes no state")
	await _drag_list(holder,(view.get("_action") as Button).get_global_rect().get_center())
	_check(_state_json(app)==before,"swipe off paid departure cancels")
	var wallet: int=st.wallet
	await _tap(holder,view,"ExplorePrimary")
	_check(st.wallet==wallet-1600,"pointer pays departure exactly once")
	app.call("advance_travel",0.6)
	view=await _show(app)
	_check((view.get("_action") as Button).disabled,"visible travel blocks repeat actions")
	await _shot(holder,tag+"_mountain_04_travel.png")
	view=await _arrive_at(app)
	view=await _choose(holder,app,"buckwheat_mill")
	_check_mountain_layout(view,holder,tag+" quantity")
	await _shot(holder,tag+"_mountain_05_quantity.png")
	view=await _choose(holder,app,"clean_three")
	_check(st.wallet==wallet-2400 and st.sample_stock("noodle_buckwheat")==0,"pending reward and extra800 exact")
	await _shot(holder,tag+"_mountain_06_pending.png")
	before=_state_json(app)
	app.queue_free()
	await _settle()
	app=await _spawn(holder,dir)
	app.set_process(false)
	st=app.get("state")
	app.call("_open_overlay",6)
	view=await _arrive_at(app)
	_check(_state_json(app)==before,"pending native restart preserves full state")
	await _tap(holder,view,"ExplorePrimary")
	_check(st.sample_stock("noodle_buckwheat")==3,"pointer claims exactly three")
	await _settle()
	await _shot(holder,tag+"_mountain_07_received.png")
	before=_state_json(app)
	await _tap(holder,view,"ExplorePrimary")
	var editor: Control=app.get("_bowl_editor")
	_check(editor.is_visible_in_tree() and _state_json(app)==before,"handoff opens native noodle details without modifying draft")
	await _shot(holder,tag+"_mountain_08_noodle_detail.png")
	await _tap(holder,editor,"EditorDetailApply")
	_check(st.draft_config["noodle"]=="noodle_buckwheat","explicit native apply selects new noodle")
	_check(editor.call("_ingredient_texture","noodle_buckwheat")==FoodArt.food("noodle_buckwheat"),"native new noodle detail uses actual buckwheat asset")
	await _tap(holder,editor,"EditorDetailsBack")
	fixture.compose(st,"mountain_clear")
	app.call("_refresh_all")
	app.call("_sync_bowl_editor")
	await _settle()
	_assert_current_stage(editor,tag+" buckwheat bowl")
	await _shot(holder,tag+"_mountain_09_buckwheat_bowl.png")
	before=_state_json(app)
	await _tap(holder,editor,"EditorTaste")
	app.call("advance_work",0.6)
	app.call("_sync_bowl_editor")
	await _settle()
	_assert_current_stage(editor,tag+" cooking")
	var viewport_bounds:=Rect2(Vector2.ZERO,Vector2(holder.size))
	_check(viewport_bounds.encloses((editor.get("_scene") as Control).get_global_rect()),tag+": cooking cannot inflate scene beyond actual viewport")
	_check(viewport_bounds.encloses((editor.get("_taste") as Button).get_global_rect()),tag+": cooking retains the fixed footer inside viewport")
	await _shot(holder,tag+"_mountain_10_cooking.png")
	await _tap(holder,editor,"EditorCancel")
	_check(_state_json(app)==before and st.sample_stock("noodle_buckwheat")==3,"canceled cooking preserves all money/samples/records")
	await _tap(holder,editor,"EditorTaste")
	_check(app.call("advance_work",100.0),"real work reaches completed tasting")
	app.call("_sync_bowl_editor")
	await _settle()
	_check(st.sample_stock("noodle_buckwheat")==2,"actual UI completion consumes one sample")
	await _shot(holder,tag+"_mountain_11_noodle_result.png")
	_check(st.serve()["ok"],"actual service opens shared next day")
	_check(app.call("_persist"),"save new tasting and service")
	view.open_samples("mountain")
	app.call("_open_overlay",6)
	view=await _show(app)
	await _tap(holder,view,"ExplorePrimary")
	view=await _arrive_at(app)
	view=await _choose(holder,app,"shiitake_grill")
	view=await _choose(holder,app,"clean_three")
	await _tap(holder,view,"ExplorePrimary")
	await _shot(holder,tag+"_mountain_12_shiitake_received.png")
	await _tap(holder,view,"ExplorePrimary")
	_check(_state_json(app).contains("topping_grilled_shiitake"),"real new stock serialized")
	await _shot(holder,tag+"_mountain_13_shiitake_detail.png")
	await _tap(holder,editor,"EditorDetailApply")
	_check(IngredientCatalog.toppings_of(st.draft_config).has("topping_grilled_shiitake"),"explicit native add includes new topping")
	fixture.compose(st,"shiitake_depth")
	app.call("_refresh_all")
	app.call("_sync_bowl_editor")
	await _settle()
	await _tap(holder,editor,"EditorAdd_topping_grilled_shiitake")
	_check(IngredientCatalog.toppings_of(st.draft_config).count("topping_grilled_shiitake")==2,"real native add repeats same topping in a second rank slot")
	_assert_current_stage(editor,tag+" repeated shiitake")
	await _shot(holder,tag+"_mountain_14_shiitake_bowl.png")
	await _tap(holder,editor,"EditorMenu")
	await _tap(holder,editor,"EditorDirections")
	await _tap(holder,editor,"EditorDirection_mountain_clear")
	before=_state_json(app)
	await _tap(holder,editor,"EditorDirectionExplore")
	view=await _show(app)
	_check(view.region=="mountain" and view.mode=="sample" and _state_json(app)==before,"direction source leads to correct region without spend/apply")
	await _shot(holder,tag+"_mountain_15_source.png")
	_check_mountain_layout(view,holder,tag+" final source")
	_check(app.call("_persist"),"save final stock and draft")
	before=_state_json(app)
	app.queue_free()
	await _settle()
	app=await _spawn(holder,dir)
	app.set_process(false)
	_check(_state_json(app)==before,"final native disk restart exactly preserves both new ingredients")
	app.queue_free()
	holder.queue_free()
	await _settle()
